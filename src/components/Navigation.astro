---
const allRoutes = Object.values(import.meta.glob('../pages/**/*.astro', { eager: true }))
.filter(page => { console.log('URL: ', page.url); page.url !== '/pieceForSmartphoneOrchestra/sound-test'} )
.sort((page1, page2) => page1.order - page2.order)
.map(page => page.url)

console.log('ALL ROUTES', Object.values(import.meta.glob('../pages/**/*.astro', { eager: true })))
---

<nav>
  {allRoutes.map(path => {
  const currentPage = path === Astro.url.pathname
  ? 'currentPage'
  : ''
  const route = path.split('/')[2]
  console.log('PATH', Astro.url.pathname, route)
  const linkText = path === '/pieceForSmartphoneOrchestra' ? 'About' : route.charAt(0).toUpperCase() + route.slice(1)
  return <a href={path} class={currentPage}>{linkText}</a>
  })}
</nav>

<style>
 nav {
   width: 95%;
   max-width: inherit;
   margin-top: 0;
   position: fixed;
   top: 0;
   border-bottom: 0.2px solid var(--text-color);
   padding-right: 2px;
   height: 2.5rem;
   background-color: inherit;
   display: flex;
   justify-content: flex-end;
   column-gap: 0.8rem;
   align-items: center;
 }

 a {
   color: inherit;
   font-size: 0.9rem;
   text-decoration: none;
 }

 .currentPage {
   --symbol-char: '\00B7';/* dot character */
   --symbol-margin: 2px;
   letter-spacing: 0.8px;
   pointer-events: none;
 }

 .currentPage::before {
   content: var(--symbol-char);
   margin-right: var(--symbol-margin);
 }

 .currentPage::after {
   content: var(--symbol-char);
   margin-left: var(--symbol-margin);
 }
</style>
